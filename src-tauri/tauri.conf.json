{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aphendo",
  "version": "0.2.4",
  "identifier": "com.capturetodo.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aphendo",
        "width": 1100,
        "height": 760,
        "minWidth": 400,
        "minHeight": 520,
        "resizable": true,
        "alwaysOnTop": false,
        "decorations": false,
        "skipTaskbar": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwODQ1OTAwMEMyRjZCNDYKUldSR2F5OE1BRm1FRUtMejhJOGllSjlGVkdKSDBzdmNIWFZBbjZSSlNzOU9MNXM0b3grWTM1OFMK",
      "endpoints": [
        "https://github.com/team-poem/aphendo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
